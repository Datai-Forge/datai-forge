# ==============================================================================
# FICHIER DE CONFIGURATION DES SECRETS (EXEMPLE)
# ==============================================================================
# Instructions :
# 1. Copiez ce fichier : cp .secrets.example .secrets
# 2. Remplissez les valeurs manquantes dans .secrets
# 3. Ne committez JAMAIS le fichier .secrets sur Git
# ==============================================================================

# --- Configuration Docker Hub (Optionnel pour le CI/CD) ---
DOCKERHUB_USERNAME=votre_pseudo
DOCKERHUB_TOKEN=votre_token_dacces

# --- Configuration MySQL ---
# Mot de passe du compte 'root' (administrateur)
MYSQL_ROOT_PASSWORD=root_secure_password_2026

# Nom de la base de données décisionnelle (Couche GOLD)
MYSQL_DATABASE=lyon_decisional

# Utilisateur applicatif et son mot de passe
MYSQL_USER=lyon_user
MYSQL_PASSWORD=lyon_secure_password_2026

# --- Configuration de l'application ---
# Ces variables permettent à l'application Python de savoir où se connecter
MYSQL_HOST=mysql
MYSQL_PORT=3306
